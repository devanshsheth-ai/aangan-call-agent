# Copy this file to .env.local and fill it in.  Never commit .env.local.  Never paste these values into a chat.
# For the live app, put the same names and values in Vercel > Project > Settings > Environment Variables.
# docs/SETUP.md says where to find every value.

# --- Security: you invent these two. Use long random values, and make them different from each other.
# Generate one with:  openssl rand -hex 32
VAANI_WEBHOOK_SECRET=
LINK_SECRET=
# Dashboard password (username is "aangan"). Pick something strong.
DASHBOARD_PASSWORD=

# --- Where the app lives. No trailing slash.  Local: http://localhost:3000   Live: https://your-app.vercel.app
APP_URL=http://localhost:3000

# --- Gemini (AI classifier). aistudio.google.com/apikey. Run `npm run models` to pick the model name.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional, for the cost tile: rupees per million tokens. Leave 0 on the free tier.
GEMINI_INR_PER_M_INPUT=0
GEMINI_INR_PER_M_OUTPUT=0

# --- Vaani voice cost: your per-minute rate in rupees (Vaani billing page). Used for the cost tile.
VAANI_RATE_INR_PER_MIN=0

# --- Neon (database). console.neon.tech > your project > Dashboard > Connect > copy the connection string.
# It looks like postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Resend (email). resend.com > API Keys > Sending access.
RESEND_API_KEY=
# With no domain, use: Aangan Studio <onboarding@resend.dev>  (it only delivers to your Resend signup email)
EMAIL_FROM=Aangan Studio <onboarding@resend.dev>
# Where complaints and failure fallbacks go.
FRONT_DESK_EMAIL=

# --- HubSpot (CRM). Optional: leave empty to skip deals.  Settings > Integrations > Private Apps.
HUBSPOT_PRIVATE_APP_TOKEN=
# Optional overrides. Defaults: pipeline "default", stage "appointmentscheduled".
HUBSPOT_PIPELINE=
HUBSPOT_DEAL_STAGE=

# --- Booking link shown to designers on "Reschedule". Optional. Calendly or Cal.com link.
CALCOM_BOOKING_URL=
