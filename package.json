{
  "name": "aangan-call-agent",
  "private": true,
  "version": "1.0.0",
  "description": "Aangan Studio: AI call agent handoff pipeline (Vaani webhook -> Gemini -> Neon -> email/HubSpot -> dashboard)",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "node --env-file=.env.local scripts/doctor.mjs",
    "models": "node --env-file=.env.local scripts/list-models.mjs",
    "smoke:store": "tsx --env-file=.env.local scripts/smoke-store.mts",
    "eval": "tsx --env-file=.env.local scripts/run-eval.mts",
    "test:webhook": "node --env-file=.env.local scripts/send-test-webhook.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
